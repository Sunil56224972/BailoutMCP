# BailoutMCP Production Configuration (100% Real Providers — Zero Mock/Fake Data)
# Choose a real provider: anthropic | gemini | openai | openrouter | ollama | custom
BAILOUT_PROVIDER=anthropic
# Optional ordered fallback chain:
# BAILOUT_FALLBACK_PROVIDERS=gemini,openrouter

# Anthropic Opus (BAILOUT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
BAILOUT_ANTHROPIC_MODEL=claude-opus-4-6

# Google Gemini Pro (BAILOUT_PROVIDER=gemini)
GEMINI_API_KEY=
BAILOUT_GEMINI_MODEL=gemini-2.5-pro

# OpenAI (BAILOUT_PROVIDER=openai — supports o3/o4 reasoning models automatically)
OPENAI_API_KEY=
BAILOUT_OPENAI_MODEL=o3

# OpenRouter (BAILOUT_PROVIDER=openrouter)
OPENROUTER_API_KEY=
BAILOUT_OPENROUTER_MODEL=anthropic/claude-opus-4.6

# Local Ollama LLM (BAILOUT_PROVIDER=ollama — 100% offline real model)
BAILOUT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
BAILOUT_OLLAMA_MODEL=qwen2.5-coder:32b

# Custom Dynamic Model Router / LiteLLM Proxy (BAILOUT_PROVIDER=custom)
BAILOUT_ROUTER_URL=http://127.0.0.1:4000/v1/chat/completions
BAILOUT_ROUTER_API_KEY=
BAILOUT_ROUTER_MODEL=opus-bailout

# Thresholds, Security & Anti-Annoyance Timing Gate
BAILOUT_STUCK_THRESHOLD=70
BAILOUT_PAUSE_GATE_MS=3500
BAILOUT_COOLDOWN_MS=300000
BAILOUT_MIN_CONFIDENCE=0.72
BAILOUT_MAX_PER_HOUR=6
BAILOUT_MAX_PATCH_LINES=35
BAILOUT_SOLVE_TIMEOUT_MS=45000
BAILOUT_BRIDGE_PORT=47821
# Optional semicolon/colon-separated allowed workspace roots (defaults to cwd)
# BAILOUT_ALLOWED_ROOTS=
