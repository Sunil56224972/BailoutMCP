{
  "name": "@bailout-mcp/core",
  "version": "0.1.0",
  "description": "Shadow-State Frustration Engine, Timing Gate, Context Distiller, and Universal Multi-Provider Bailout Router",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
